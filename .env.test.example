# Dedicated PostgreSQL database for integration tests. Never point this at a development database.
DATABASE_URL=postgresql://mailbox:mailbox@localhost:5433/mailbox_test
AUTH_SECRET=test-only-secret-that-is-at-least-32-characters-long
AUTH_TRUST_HOST=true
PROVIDER_DELAY_MS=0
PROVIDER_FAILURE_RATE=0
WORKER_LEASE_MS=45000
