# Application database
DATABASE_URL=postgresql://mailbox:mailbox@localhost:5432/mailbox

# Auth.js
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters
AUTH_TRUST_HOST=true

# Worker behavior
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_MS=45000
PROVIDER_DELAY_MS=2500
PROVIDER_FAILURE_RATE=0.2
